#include <iostream>
#include <cmath>
using namespace std;
class Distance {
private:
    int feet;
    float inches;
public:
    void getDist() {
        cout<<"Enter feet:";
        cin>>feet;
        cout<<"Enter inches: ";
        cin>>inches;
    }
    Distance addDist(Distance d2) {
        Distance temp;
        temp.feet=feet+d2.feet;
        temp.inches=inches+d2.inches;
        while (temp.inches >= 12.0) {
            temp.feet++;
            temp.inches -= 12.0;
        }
        return temp;
    }
    Distance subDist(Distance d2) {
        Distance temp;
        float total1=(feet * 12.0) + inches;
        float total2=(d2.feet * 12.0) + d2.inches;
        float diff=abs(total1 - total2);
        temp.feet=(int)diff/12;
        temp.inches=(int)diff%12+(diff-(int)diff);
        return temp;
    }
    void showDist() {
        cout <<"Feet:"<<feet<< endl;
        cout <<"Inches:"<<inches<< endl;
    }
};
int main() {
    Distance d1, d2, sum, diff;
    cout<<"Enter First Distance"<<endl;
    d1.getDist();
    cout<< "Enter Second Distance"<<endl;
    d2.getDist();
    sum=d1.addDist(d2);
    diff=d1.subDist(d2);
    cout<<"Sum of Distances:"<<endl;
    sum.showDist();
    cout<<"Difference of Distances:"<<endl;
    diff.showDist();
    return 0;
}
